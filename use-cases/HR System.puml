@startuml
left to right direction
actor HR as "HR Advisor"
actor DM as "Department Manager"
rectangle Database
rectangle "HR System" {
    usecase UC1 as "1. Get all salaries"
    usecase UC2 as "2. Get salaries\nby department"
    usecase UC3 as "3. Get salaries\nfor own department"
    usecase UC4 as "4. Get salaries\nby role"
    usecase UCa as "Print salaries"
    usecase UC5 as "5. Add employee details"
    usecase UC6 as "6. View employee details"
    usecase UC7 as "7. Update employee details"
    usecase UC8 as "8. Delete employee details"
    UC1 ..> UCa : <<include>>
    UC2 ..> UCa : <<include>>
    UC3 ..> UCa : <<include>>
    UC4 ..> UCa : <<include>>
}
HR -- UC1
HR -- UC2
HR -- UC4
HR -- UC5
HR -- UC6
HR -- UC7
HR -- UC8
DM -- UC3
UC1 -- Database
UC2 -- Database
UC3 -- Database
UC4 -- Database
UC5 -- Database
UC6 -- Database
UC7 -- Database
UC8 -- Database
@enduml
